{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "node_modules/.cache/forge-out",
    "types": ["node"]
  },
  "include": ["src", "test"],
  "exclude": ["node_modules", "static", "landing"]
}
